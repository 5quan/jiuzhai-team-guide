# Copy to .env. Never commit actual secrets. Node.js 24+.
CHAT_ENABLED=0
CHAT_DB=./storage/chat.sqlite
# Local: http://localhost:3000. Production: https://YOUR_PUBLIC_IP
CHAT_ORIGIN=http://localhost:3000
# Generate independent random values (see docs/chat-deployment.md).
CHAT_INVITE_CODE=
CHAT_ENCRYPTION_KEY=
DEEPSEEK_MODEL=deepseek-flash
# 主动消息默认关闭。开启后，长时间没说话的账号可能收到一条主动消息（使用该账号自己的 Key）。
CHAT_PROACTIVE=0
# 联网搜索默认开启：只有问到天气、开放时间、票价这类实时信息时才会调用一次。
CHAT_SEARCH=1
GUIDE_BIND=127.0.0.1
GUIDE_PORT=3000
